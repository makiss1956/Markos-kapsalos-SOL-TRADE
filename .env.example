# ============================================================
# sol_trade — Αντιγράψτε αυτό το αρχείο σε .env και συμπληρώστε
# ό,τι χρειάζεστε:   cp .env.example .env
#
# Το .env ΔΕΝ ανεβαίνει ποτέ στο GitHub (είναι στο .gitignore).
# ============================================================

# Λειτουργία: paper (προσομοίωση) ή live (πραγματικές συναλλαγές)
SOL_TRADE_MODE=paper

# Solana RPC (χρήσιμο μόνο για live mode)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Κλειδί Jupiter API — μόνο για LIVE mode (δωρεάν: https://developers.jup.ag/portal)
# ΧΩΡΙΣ κλειδί, το paper mode χρησιμοποιεί αυτόματα το δωρεάν lite-api.jup.ag
JUPITER_API_KEY=

# Ιδιωτικό κλειδί πορτοφολιού — ΜΟΝΟ για live mode (Base58 ή πίνακας 64 ακεραίων)
# Χρησιμοποιήστε ΝΕΟ πορτοφόλι μόνο για το bot, με μικρό ποσό!
SOL_PRIVATE_KEY=

# Telegram ειδοποιήσεις (προαιρετικό — δουλεύει και στο paper mode)
# 1) Φτιάξτε bot μέσω του @BotFather -> πάρετε το token
# 2) Στείλτε ένα μήνυμα στο bot σας και πάρτε το chat id από τον @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
